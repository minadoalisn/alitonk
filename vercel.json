{
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "redirects": [
    {
      "destination": "https://minadoai.com/$1",
      "has": [
        {
          "type": "host",
          "value": "www.minadoai.com"
        }
      ],
      "permanent": true,
      "source": "/(.*)"
    }
  ]
}
